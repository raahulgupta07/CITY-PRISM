# Copy to .env and fill in. Never commit .env.

# dev | prod. With prod, the test sign-in is off and SECRET_KEY is required.
ENV=dev
# Signs the session cookie. Use a long random value in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Leave empty to use SQLite in /app/backend/data/prism.db.
# Set a PostgreSQL URL to switch (decide before go-live; data is not moved for you).
DATABASE_URL=

# AI through OpenRouter (used from phase 3). The key stays on the server.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model IDs from the CityGPT routing. Fast model: Interview. Default: everything else.
LLM_MODEL_FAST=
LLM_MODEL_DEFAULT=
# Seconds before an AI call gives up (no automatic retry).
LLM_TIMEOUT_SECONDS=60
