# Copy to .env and fill in. Never commit .env.

# dev | prod. With prod, the test sign-in is off and SECRET_KEY is required.
ENV=dev
# Signs the session cookie. Use a long random value in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Leave empty to use SQLite in /app/backend/data/prism.db.
# Set a PostgreSQL URL to switch (decide before go-live; data is not moved for you).
DATABASE_URL=

# AI through OpenRouter (used from phase 3). The key stays on the server.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model IDs from the CityGPT routing. Fast model: Interview. Default: everything else.
LLM_MODEL_FAST=
LLM_MODEL_DEFAULT=
# Seconds before an AI call gives up (no automatic retry).
LLM_TIMEOUT_SECONDS=60

# The address people open. Needed for company sign-in.
PUBLIC_URL=
# Company sign-in (OpenID Connect, e.g. Microsoft Entra ID). Empty issuer = off.
#   Entra ID: https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated email domains allowed to sign in.
OIDC_ALLOWED_DOMAINS=cityholdings.com.mm
# Create a project owner account the first time a staff member signs in.
OIDC_CREATE_USERS=true
